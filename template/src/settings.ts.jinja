import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
import { loadPiExtensionSettings, type PiSettingsContext } from "@zigai/pi-extension-settings/pi";
import { definePrevalidatedExtensionSettings } from "@zigai/pi-extension-settings/runtime";
import type { StaticDecode } from "typebox";

import prevalidatedSettings from "./settings.prevalidated.ts";
import settingsInput, { settingsSchema } from "./settings-input.ts";

export type ExtensionSettings = StaticDecode<typeof settingsSchema>;

export const extensionSettingsDefinition = definePrevalidatedExtensionSettings(
    settingsInput,
    prevalidatedSettings,
);

/** Load resolved global and trusted-project settings for this session. */
export function {{ settings_loader_name }}(ctx: PiSettingsContext) {
    return loadPiExtensionSettings(extensionSettingsDefinition, ctx, {
        bundledSchema: {
            kind: "url",
            url: new URL("../config.schema.json", import.meta.url),
        },
    });
}

/** Own one lazy settings snapshot per session, including disabled and invalid results. */
export function createSessionSettings() {
    let loaded: ReturnType<typeof {{ settings_loader_name }}> | undefined;

    return {
        get(ctx: ExtensionContext): ExtensionSettings | undefined {
            if (loaded === undefined) {
                loaded = {{ settings_loader_name }}(ctx);
                if (ctx.hasUI) {
                    for (const diagnostic of loaded.diagnostics) {
                        ctx.ui.notify(diagnostic.message, diagnostic.severity);
                    }
                }
            }
            return loaded.settings.enabled ? loaded.settings : undefined;
        },
        reset(): void {
            loaded = undefined;
        },
    };
}

export default extensionSettingsDefinition;
