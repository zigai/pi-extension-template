import { access, mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

import { DefaultResourceLoader } from "@earendil-works/pi-coding-agent";
import { describe, expect, it } from "vitest";

const extensionPath = fileURLToPath(new URL({{ ("../dist/index.ts" if build_mode == "bundle" else "../src/index.ts")|tojson }}, import.meta.url));

async function loadExtension(root: string, agentDir: string) {
    const previousAgentDir = process.env.PI_CODING_AGENT_DIR;
    process.env.PI_CODING_AGENT_DIR = agentDir;
    try {
        const loader = new DefaultResourceLoader({
            cwd: root,
            agentDir,
            additionalExtensionPaths: [extensionPath],
        });
        await loader.reload();
        return loader.getExtensions();
    } finally {
        if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;
        else process.env.PI_CODING_AGENT_DIR = previousAgentDir;
    }
}

describe.sequential({{ (title_name ~ " extension")|tojson }}, () => {
    it("loads through Pi and registers its lifecycle contract", async () => {
        const root = await mkdtemp(path.join(tmpdir(), {{ (repo_name ~ "-enabled-")|tojson }}));
        try {
            const loaded = await loadExtension(root, path.join(root, "agent"));
            expect(loaded.errors).toEqual([]);
            expect(loaded.extensions).toHaveLength(1);
            expect(loaded.extensions[0]?.handlers.has("session_start")).toBe(true);
            expect(loaded.extensions[0]?.handlers.has("session_shutdown")).toBe(true);

            const sessionStartHandlers = loaded.extensions[0]?.handlers.get("session_start") ?? [];
            expect(sessionStartHandlers).toHaveLength(1);
            for (const handler of sessionStartHandlers) {
                await handler({ type: "session_start", reason: "startup" }, {});
            }

            await expect(
                access(path.join(root, "agent", "extension-settings", {{ (repo_name ~ ".json")|tojson }})),
            ).rejects.toMatchObject({ code: "ENOENT" });
        } finally {
            await rm(root, { recursive: true, force: true });
        }
    });

    it("preserves the synchronous lifecycle contract when globally disabled", async () => {
        const root = await mkdtemp(path.join(tmpdir(), {{ (repo_name ~ "-disabled-")|tojson }}));
        const agentDir = path.join(root, "agent");
        const settingsDirectory = path.join(agentDir, "extension-settings");
        const settingsPath = path.join(settingsDirectory, {{ (repo_name ~ ".json")|tojson }});
        const disabledSettings = `${JSON.stringify({ enabled: false }, undefined, 2)}\n`;
        try {
            await mkdir(settingsDirectory, { recursive: true });
            await writeFile(settingsPath, disabledSettings);

            const loaded = await loadExtension(root, agentDir);
            expect(loaded.errors).toEqual([]);
            expect(loaded.extensions).toHaveLength(1);
            expect(loaded.extensions[0]?.handlers.has("session_start")).toBe(true);
            expect(loaded.extensions[0]?.handlers.has("session_shutdown")).toBe(true);
            expect(loaded.extensions[0]?.commands.size).toBe(0);
            expect(loaded.extensions[0]?.tools.size).toBe(0);
            await expect(readFile(settingsPath, "utf8")).resolves.toBe(disabledSettings);
        } finally {
            await rm(root, { recursive: true, force: true });
        }
    });
});
